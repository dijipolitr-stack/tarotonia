# Tarotonia - Environment Variables
# Bu dosyayı .env olarak kopyalayıp doldurun. Production'da bu değerler
# Vercel Dashboard > Settings > Environment Variables üzerinden eklenir.

# Anthropic API anahtarı (console.anthropic.com). AI okumalarını üretir.
# ASLA frontend'e konmaz, sadece backend (api/reading.js) kullanır.
ANTHROPIC_API_KEY=sk-ant-api03-...

# Admin endpoint'lerini (kod üretme, istatistik) koruyan gizli anahtar.
# Güçlü ve rastgele olsun, minimum 32 karakter önerilir.
ADMIN_SECRET=

# --- Aşağıdakiler Vercel KV oluşturulunca OTOMATİK eklenir, elle yazmayın ---
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
